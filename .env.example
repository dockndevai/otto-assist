# --- Brain (choose ONE auth path) ---
# Option A: leave this unset to reuse your already-logged-in `claude` CLI auth.
# Option B: set an API key to use it directly.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional premium voice (TTS) ---
# If set, Jarvis speaks with ElevenLabs instead of the local macOS voice.
# ELEVENLABS_API_KEY=

# --- Optional wake-word backend ---
# openWakeWord (default) needs no key. Set this only if you switch to Porcupine.
# PICOVOICE_ACCESS_KEY=
