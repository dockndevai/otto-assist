#!/usr/bin/env bash
# Otto's Homebrew launcher.
#
# The formula vendors Otto's source read-only into the Cellar (OTTO_LIBEXEC) and puts this
# script on PATH as `otto`. Python deps (Whisper, torch, …) are too large and platform-specific
# to vendor as Homebrew resources, so we build a normal virtualenv in a user-writable location
# on first use and run everything from there.
#
# Env provided by the formula:
#   OTTO_LIBEXEC       — the vendored source tree (contains pyproject.toml, otto/, run.py)
#   OTTO_BREW_PYTHON   — the python3 interpreter to build the venv with (Homebrew's python@3.x)
set -euo pipefail

LIBEXEC="${OTTO_LIBEXEC:-$(cd "$(dirname "$0")/.." && pwd)}"
PYBIN="${OTTO_BREW_PYTHON:-python3}"
# Data + venv live here (override with OTTO_HOME to match the app's own storage).
OTTO_DATA="${OTTO_HOME:-$HOME/Library/Application Support/Otto}"
VENV="${OTTO_VENV:-$OTTO_DATA/venv}"
PY="$VENV/bin/python"
STAMP="$VENV/.otto-installed"

bold() { printf "\033[1m%s\033[0m\n" "$1"; }

# Make Homebrew's ffmpeg/portaudio discoverable to the venv build + runtime.
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
  export PATH="$BREW_PREFIX/bin:$PATH"
  PORTAUDIO="$(brew --prefix portaudio 2>/dev/null || true)"
  if [ -n "${PORTAUDIO:-}" ]; then
    export CFLAGS="-I$PORTAUDIO/include${CFLAGS:+ $CFLAGS}"
    export LDFLAGS="-L$PORTAUDIO/lib${LDFLAGS:+ $LDFLAGS}"
  fi
fi

setup() {
  mkdir -p "$OTTO_DATA"
  if [ ! -x "$PY" ]; then
    bold "▶ Creating Otto's Python environment"
    echo "  $VENV"
    "$PYBIN" -m venv "$VENV"
  fi
  bold "▶ Installing Otto + voice/menu-bar dependencies (first run downloads a lot — be patient)"
  "$PY" -m pip install --upgrade pip >/dev/null
  "$PY" -m pip install "$LIBEXEC"'[voice,app]' || {
    echo "  Some voice extras failed to build; installing the core (text path still works)."
    "$PY" -m pip install "$LIBEXEC"
  }
  bold "▶ Pre-downloading the Whisper model"
  MODEL="$("$PY" - <<'PY'
try:
    from otto.config import load_settings
    print(load_settings().voice.stt.model)
except Exception:
    print("small.en")
PY
)"
  "$PY" - "$MODEL" <<'PY' || echo "  Model prefetch skipped (downloads on first listen)."
import sys
from faster_whisper import WhisperModel
WhisperModel(sys.argv[1])
print("  Whisper model ready:", sys.argv[1])
PY
  date > "$STAMP"
  bold "✓ Otto is ready."
}

ensure_setup() { [ -f "$STAMP" ] && [ -x "$PY" ] || setup; }

# --- Spotlight-launchable app bundle -----------------------------------------
# Homebrew installs a CLI, not a .app, so Otto isn't in Spotlight. This drops a tiny
# Otto.app into ~/Applications that just launches the menu-bar app — making Otto
# searchable in Spotlight and double-clickable, without a heavyweight py2app build.
APP_DIR="$HOME/Applications/Otto.app"

install_app() {
  local otto_bin
  otto_bin="$(command -v otto || echo "$HOME/.local/bin/otto")"
  rm -rf "$APP_DIR"
  mkdir -p "$APP_DIR/Contents/MacOS" "$APP_DIR/Contents/Resources"
  cat > "$APP_DIR/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Otto</string>
    <key>CFBundleDisplayName</key><string>Otto</string>
    <key>CFBundleIdentifier</key><string>com.otto.assistant.app</string>
    <key>CFBundleVersion</key><string>1.0</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleExecutable</key><string>Otto</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleIconFile</key><string>otto</string>
    <key>LSUIElement</key><true/>
    <key>LSMinimumSystemVersion</key><string>12.0</string>
</dict>
</plist>
PLIST
  cat > "$APP_DIR/Contents/MacOS/Otto" <<LAUNCH
#!/bin/bash
# Otto.app — launches the menu-bar assistant via the Homebrew CLI.
exec "$otto_bin" menubar
LAUNCH
  chmod +x "$APP_DIR/Contents/MacOS/Otto"

  # Best-effort app icon from the packaged logo (skipped silently if tools/logo absent).
  local logo="$LIBEXEC/otto/assets/otto-logo.png"
  [ -f "$logo" ] || logo="$LIBEXEC/assets/otto-logo.png"
  if [ -f "$logo" ] && command -v sips >/dev/null 2>&1 && command -v iconutil >/dev/null 2>&1; then
    local ico; ico="$(mktemp -d)/otto.iconset"; mkdir -p "$ico"
    for s in 16 32 64 128 256 512; do
      sips -z $s $s "$logo" --out "$ico/icon_${s}x${s}.png" >/dev/null 2>&1 || true
      sips -z $((s*2)) $((s*2)) "$logo" --out "$ico/icon_${s}x${s}@2x.png" >/dev/null 2>&1 || true
    done
    iconutil -c icns "$ico" -o "$APP_DIR/Contents/Resources/otto.icns" >/dev/null 2>&1 || true
  fi

  # Nudge Spotlight/LaunchServices to index it now.
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
    -f "$APP_DIR" >/dev/null 2>&1 || true
  bold "✓ Installed $APP_DIR"
  echo "  Search \"Otto\" in Spotlight (⌘-Space), or double-click it in ~/Applications."
  echo "  (Use this OR 'brew services start otto' — not both, they share port 8000.)"
}

uninstall_app() { rm -rf "$APP_DIR" && echo "Removed $APP_DIR"; }

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  setup)
    setup ;;
  start|"")
    ensure_setup
    # Foreground: dashboard + voice loop (Ctrl-C to stop). Run from the source tree so
    # packaged assets/scripts resolve.
    cd "$LIBEXEC"; exec "$VENV/bin/otto" "$@" ;;
  menubar)
    ensure_setup
    # Used by `brew services`; the menu-bar app owns the run loop.
    cd "$LIBEXEC"; exec "$VENV/bin/otto-menubar" "$@" ;;
  enroll-wake)
    ensure_setup
    cd "$LIBEXEC"; exec "$PY" -m otto.enroll_wake_word "$@" ;;
  install-app)
    install_app ;;
  uninstall-app)
    uninstall_app ;;
  python)
    ensure_setup
    cd "$LIBEXEC"; exec "$PY" "$@" ;;
  version|-v|--version)
    ensure_setup >/dev/null 2>&1 || true
    "$PY" - <<'PY' 2>/dev/null || echo "otto (dev)"
try:
    import importlib.metadata as m; print("otto", m.version("otto-assist"))
except Exception:
    print("otto (dev)")
PY
    ;;
  help|-h|--help)
    cat <<EOF
Otto — a voice & a screen for the Claude you already run.

  otto setup          Build/refresh the Python environment (first run does this automatically)
  otto start          Run Otto in the foreground (dashboard at http://127.0.0.1:8000)
  otto menubar        Run the menu-bar app (used by: brew services start otto)
  otto enroll-wake    Record a custom wake word, e.g.  otto enroll-wake "hey otto"
  otto install-app    Add Otto.app to ~/Applications (Spotlight-searchable, double-click)
  otto uninstall-app  Remove that Otto.app
  otto version        Show version

Run at login in the menu bar:   brew services start otto
Stop it:                        brew services stop otto
Make it Spotlight-searchable:   otto install-app     (then search "Otto" in ⌘-Space)
EOF
    ;;
  *)
    echo "otto: unknown command '$cmd' (try: otto help)" >&2; exit 2 ;;
esac
